# Generate unique random values before startup. Use URL-safe letters and numbers for the DB password.
POSTGRES_DB=pulse_monitor
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
APP_ENV=development
APP_DEBUG=false
FRONTEND_URL=http://localhost
APP_PORT=80
APP_BIND_ADDRESS=127.0.0.1
EXTRA_ORIGINS=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_MONITORS_PER_USER=20
CHECK_RETENTION_DAYS=30
DEMO_MODE=false
# Optional Telegram bot from BotFather. Provide the username without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# For development outside Compose or a managed database. Leave unset to use Compose defaults.
# DATABASE_URL=postgresql+asyncpg://pulse_user:password@localhost:5432/pulse_monitor
# REDIS_URL=redis://localhost:6379/0
