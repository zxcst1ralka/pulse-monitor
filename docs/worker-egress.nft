# Load on Linux with nft -f docs/worker-egress.nft after reviewing local address ranges.
table inet pulse_worker {
    set blocked_v4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
                     172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15,
                     198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
    }

    set blocked_v6 {
        type ipv6_addr
        flags interval
        elements = { ::/96, ::ffff:0:0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2001::/32,
                     2001:db8::/32, 2002::/16, fc00::/7, fe80::/10, fec0::/10, ff00::/8 }
    }

    chain host_input {
        type filter hook input priority -30; policy accept;
        iifname "br-pulse-check" drop
    }

    chain public_forward {
        type filter hook forward priority -30; policy accept;
        iifname "br-pulse-check" ip daddr @blocked_v4 drop
        iifname "br-pulse-check" ip6 daddr @blocked_v6 drop
        iifname "br-pulse-check" tcp dport { 80, 443, 8080, 8443 } accept
        iifname "br-pulse-check" drop
    }
}
